<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Weatherly</title>
    <link rel="icon" href="/img/weather.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
</head>

<body>
    <div class="sky">

        <div class="clouds" aria-hidden="true">
            <div class="cloud" style="width:320px;height:64px;top:10%;animation-duration:42s;animation-delay:-4s;"></div>
            <div class="cloud" style="width:180px;height:40px;top:30%;animation-duration:58s;animation-delay:-22s;"></div>
            <div class="cloud" style="width:260px;height:52px;top:58%;animation-duration:50s;animation-delay:-31s;"></div>
            <div class="cloud" style="width:130px;height:30px;top:78%;animation-duration:37s;animation-delay:-12s;"></div>
        </div>
        <div class="stars" id="stars" aria-hidden="true"></div>

        {{>header}}

        <main class="hero">
            <p class="eyebrow">Real-time forecast</p>
            <h1>What's the<br><span class="accent">weather</span> like?</h1>
            <p class="subtitle">Search any city to get an instant, beautiful weather forecast.</p>

            <div class="search-wrap">
                <form id="weatherForm" class="search-form">
                    <input
                        class="search-input"
                        type="text"
                        name="address"
                        placeholder="City, country..."
                        autocomplete="off"
                    />
                    <button class="search-btn" type="submit">Search</button>
                </form>
            </div>

            <!-- Weather result card — hidden until JS populates it -->
            <div class="weather-card" style="display:none;">
                <div class="wc-top">
                    <div>
                        <div class="wc-city" id="city"></div>
                        <div class="wc-date" id="date"></div>
                    </div>
                    <div class="wc-icon" id="icon"></div>
                </div>
                <div class="wc-temp" id="temp"></div>
                <div class="wc-desc" id="desc"></div>
                <hr class="wc-divider">
                <div class="wc-stats">
                    <div class="stat">
                        <div class="stat-label">Humidity</div>
                        <div class="stat-val" id="hum"></div>
                    </div>
                    <div class="stat">
                        <div class="stat-label">Wind</div>
                        <div class="stat-val" id="wind"></div>
                    </div>
                    <div class="stat">
                        <div class="stat-label">Feels like</div>
                        <div class="stat-val" id="feels"></div>
                    </div>
                </div>
            </div>
        </main>

        {{>footer}}
    </div>

    <script src="/js/app.js"></script>
    <script>
        const starsEl = document.getElementById('stars')
        for (let i = 0; i < 70; i++) {
            const s = document.createElement('div')
            s.className = 'star'
            const sz = Math.random() * 2.5 + 0.8
            s.style.cssText = `width:${sz}px;height:${sz}px;top:${Math.random() * 100}%;left:${Math.random() * 100}%;animation-delay:${(Math.random() * 4).toFixed(2)}s;animation-duration:${(2 + Math.random() * 3).toFixed(2)}s;`
            starsEl.appendChild(s)
        }
    </script>
</body>

</html>
