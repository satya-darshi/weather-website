<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>About — Weatherly</title>
    <link rel="icon" href="/img/weather.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;1,9..40,300&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .about-section {
            position: relative;
            z-index: 1;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 64px 24px 96px;
        }

        .about-card {
            width: 100%;
            max-width: 640px;
            background: rgba(255, 255, 255, 0.07);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 28px;
            padding: 48px;
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            animation: fadeUp 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
        }

        .about-top {
            display: flex;
            align-items: center;
            gap: 28px;
            margin-bottom: 36px;
        }

        .portrait-wrap {
            flex-shrink: 0;
            width: 88px;
            height: 88px;
            border-radius: 50%;
            overflow: hidden;
            border: 2px solid rgba(38, 208, 206, 0.45);
            box-shadow: 0 0 0 4px rgba(38, 208, 206, 0.1);
        }

        .portrait-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .portrait-placeholder {
            width: 100%;
            height: 100%;
            background: rgba(38, 208, 206, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 32px;
        }

        .about-name {
            font-family: 'Barlow Condensed', sans-serif;
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -0.5px;
            color: #fff;
            margin-bottom: 6px;
        }

        .about-handle {
            font-size: 14px;
            color: rgba(255, 255, 255, 0.45);
            font-weight: 300;
        }

        .about-divider {
            border: none;
            border-top: 1px solid rgba(255, 255, 255, 0.1);
            margin: 0 0 32px;
        }

        .about-body {
            font-size: 16px;
            line-height: 1.75;
            color: rgba(255, 255, 255, 0.7);
            font-weight: 300;
            margin-bottom: 36px;
        }

        .about-body strong {
            color: #fff;
            font-weight: 500;
        }

        .about-body a {
            color: #26d0ce;
            text-decoration: none;
            border-bottom: 1px solid rgba(38, 208, 206, 0.3);
            transition: border-color 0.2s;
        }

        .about-body a:hover {
            border-color: rgba(38, 208, 206, 0.8);
        }

        .tech-chips {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .chip {
            padding: 7px 16px;
            background: rgba(38, 208, 206, 0.08);
            border: 1px solid rgba(38, 208, 206, 0.2);
            border-radius: 50px;
            font-size: 13px;
            color: #26d0ce;
            font-weight: 500;
            letter-spacing: 0.2px;
        }

        .page-eyebrow {
            font-size: 11px;
            letter-spacing: 3.5px;
            text-transform: uppercase;
            color: rgba(255, 255, 255, 0.4);
            margin-bottom: 20px;
            font-weight: 500;
            text-align: center;
        }
    </style>
</head>

<body>
    <div class="sky">
        <div class="clouds" aria-hidden="true">
            <div class="cloud" style="width:300px;height:60px;top:14%;animation-duration:44s;animation-delay:-8s;"></div>
            <div class="cloud" style="width:170px;height:38px;top:35%;animation-duration:60s;animation-delay:-25s;"></div>
            <div class="cloud" style="width:240px;height:50px;top:65%;animation-duration:52s;animation-delay:-36s;"></div>
        </div>
        <div class="stars" id="stars" aria-hidden="true"></div>

        {{>header}}

        <section class="about-section">
            <p class="page-eyebrow">The creator</p>

            <div class="about-card">
                <div class="about-top">
                    <div class="portrait-wrap">
                        <img src="/img/photo.jpeg" alt="Photo of Satyadarshi" onerror="this.parentElement.innerHTML='<div class=\'portrait-placeholder\'>&#9728;</div>'">
                    </div>
                    <div>
                        <div class="about-name">Satyadarshi</div>
                        <div class="about-handle">Creator &amp; Developer</div>
                    </div>
                </div>

                <hr class="about-divider">

                <p class="about-body">
                    Hey! I built <strong>Weatherly</strong> to make checking the weather a little more delightful.
                    It pulls real-time forecast data from <a href="https://weatherstack.com" target="_blank" rel="noopener">weatherstack.com</a>
                    and uses <a href="https://mapbox.com" target="_blank" rel="noopener">mapbox.com</a> to turn any city name into precise coordinates —
                    so you can search for virtually any location on Earth.
                </p>

                <div class="tech-chips">
                    <div class="chip">Node.js</div>
                    <div class="chip">Express</div>
                    <div class="chip">Handlebars</div>
                    <div class="chip">Weatherstack API</div>
                    <div class="chip">Mapbox API</div>
                </div>
            </div>
        </section>

        {{>footer}}
    </div>

    <script>
        const starsEl = document.getElementById('stars');
        for (let i = 0; i < 70; i++) {
            const s = document.createElement('div');
            s.className = 'star';
            const sz = Math.random() * 2.5 + 0.8;
            s.style.cssText = `width:${sz}px;height:${sz}px;top:${Math.random() * 100}%;left:${Math.random() * 100}%;animation-delay:${(Math.random() * 4).toFixed(2)}s;animation-duration:${(2 + Math.random() * 3).toFixed(2)}s;`;
            starsEl.appendChild(s);
        }
    </script>
</body>

</html>
